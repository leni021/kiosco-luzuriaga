<% if (promos.length> 0) { %>
    <section id="promos" class="section-promos">
        <div class="section-promos-inner">
            <h2 class="promos-title">Ofertas Imperdibles de Hoy</h2>
            <div class="promos-grid">
                <% promos.forEach(function(item) { %>
                    <div class="promo-card" id="promo-card-<%= item.id %>">
                        <div class="promo-badge">Promo</div>
                        <% if (item.nombre.includes('Milanesa')) { %>
                            <img class="promo-card-image" src="/img/promo-milanesa.png" alt="<%= item.nombre %>">
                            <% } else if (item.nombre.includes('Pancho')) { %>
                                <img class="promo-card-image" src="/img/promo-pancho.png" alt="<%= item.nombre %>">
                                <% } else { %>
                                    <div class="promo-card-image-placeholder">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                            </path>
                                        </svg>
                                    </div>
                                    <% } %>
                                        <div class="promo-card-body">
                                            <div>
                                                <div class="promo-card-name">
                                                    <%= item.nombre %>
                                                </div>
                                                <div class="promo-card-desc">
                                                    <%= item.variante %>
                                                </div>
                                                <div class="promo-card-includes">Incluye: Bebida Placer 500ml (sabor a
                                                    eleccion)</div>
                                            </div>
                                            <div>
                                                <div class="promo-card-price-row">
                                                    <span class="promo-card-price">$<%=
                                                            item.precio.toLocaleString('es-AR') %></span>
                                                    <span class="promo-card-price-hint">Precio final</span>
                                                </div>
                                                <select class="promo-sabor-select" id="sabor-<%= item.id %>">
                                                    <option value="">Elegir sabor de bebida</option>
                                                    <option value="Naranja">Naranja</option>
                                                    <option value="Pomelo">Pomelo</option>
                                                    <option value="Lima Limon">Lima Limon</option>
                                                    <option value="Manzana">Manzana</option>
                                                    <option value="Tropical">Tropical</option>
                                                </select>
                                                <% if (item.nombre.includes('Pancho')) { %>
                                                    <div class="promo-addon">
                                                        <input type="checkbox" id="addon-papas-<%= item.id %>"
                                                            value="1">
                                                        <label for="addon-papas-<%= item.id %>">Agregar lluvia de
                                                            papas</label>
                                                    </div>
                                                    <% } %>
                                                        <button class="btn-add-promo"
                                                            onclick="addToCart(<%= item.id %>, '<%= item.nombre %>', '<%= item.variante %>', <%= item.precio %>, <%= item.es_promo %>)"
                                                            id="btn-add-<%= item.id %>">
                                                            Agregar al Pedido
                                                        </button>
                                            </div>
                                        </div>
                    </div>
                    <% }); %>
            </div>
        </div>
    </section>
    <% } %>